# RailSense AI - environment template
# Copy to .env (never commit .env). Ask the team leader for the shared values privately.
# Everyone must use the SAME Supabase, DATABASE_URL and NIC_HMAC_SECRET values: all four
# laptops share one database. Check your setup any time with:  python check_setup.py

# ---- Shared database (required) -------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ---- Security (required; identical on every laptop) ------------------------------------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
# NIC numbers are stored as HMAC hashes; a different secret on one laptop makes duplicate
# and fraud checks disagree on the shared database.
NIC_HMAC_SECRET=ask-the-team-leader

# ---- LLMs (optional: rule-based fallbacks without them) --------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# M1 chat phrases its answers with an LLM through OpenRouter (needs `pip install openai`)
OPENROUTER_API_KEY=

# ---- Ports ----------------------------------------------------------------------------
# Don't set agent URLs or ports here. `python start.py` reads railsense_ports.json, picks
# free ports on this laptop and passes the addresses to every agent and page:
#   user side http://localhost:3000/user     admin side http://localhost:3001/admin

# ---- Gateway rate limiting / timeouts (optional) ---------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_SECOND=5
HTTP_TIMEOUT=25
LOG_LEVEL=info

# ---- Email notifications (optional, placeholders) --------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_USE_TLS=true

# ---- Optional extras --------------------------------------------------------------------
# Upstash Redis pub/sub for M2 delay alerts (M4 keeps its own in M4-maintenance-agent/.env)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
