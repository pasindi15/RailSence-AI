# M4 — Maintenance & Asset Intelligence Agent
# Copy to .env and fill in real values. .env is gitignored.

# Data layer (shared Supabase project across all 4 agents)
DATABASE_URL=postgresql://...supabase.co/...
SUPABASE_URL=
SUPABASE_KEY=

# Pub/sub events (maintenance_alert published here)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# LLM (Groq — free tier, llama-3.3-70b-versatile)
GROQ_API_KEY=

# Inter-agent auth (issued by the Hub / Security agent)
JWT_SECRET=
HUB_BASE_URL=http://localhost:8000

# This service
MAINTENANCE_AGENT_PORT=8002
MAINTENANCE_AGENT_URL=http://localhost:8002
