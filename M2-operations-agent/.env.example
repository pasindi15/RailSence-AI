# M2 — Operations & Delay-Prediction Agent
# Copy to .env and fill in real values. .env is gitignored.

# Data layer (shared Supabase project across all 4 agents)
DATABASE_URL=postgresql://...supabase.co/...
SUPABASE_URL=
SUPABASE_KEY=

# Pub/sub events (delay_alert published here, maintenance_alert consumed)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# LLM
ANTHROPIC_API_KEY=

# Inter-agent auth (issued by the Hub / Security agent)
JWT_SECRET=
HUB_BASE_URL=http://localhost:8000

# This service
OPERATIONS_AGENT_PORT=8001
