# .env.example — copy to .env and fill in real values before running Phase 2+
# Phase 1 runs without any of these set.

# ── Phase 2 — Agent credentials ──────────────────────────────────────────────
# Plaintext secrets for each agent — hashed with bcrypt at startup.
# Change these in production. Agents must supply the matching secret to
# POST /auth/login to receive a JWT.
PASSENGER_SECRET=passenger-dev-secret
OPERATIONS_SECRET=operations-dev-secret
MAINTENANCE_SECRET=maintenance-dev-secret
SECURITY_SECRET=security-dev-secret

# Optional: if set, POST /hub/register requires X-Agent-Secret header to match.
# Leave unset (or empty) to allow open registration (Phase 1 behaviour).
# AGENT_REGISTRATION_SECRET=your-registration-secret

# ── Phase 2 — JWT Authentication ─────────────────────────────────────────────
# Secret key for HS256 JWT signing. Use a long random string in production.
JWT_SECRET=your-secret-key-here

# Algorithm used for JWT signing (do not change unless you update jwt_handler.py)
JWT_ALGORITHM=HS256

# How many minutes a token stays valid before expiring
JWT_EXPIRY_MINUTES=60

# 32-byte AES key for Fernet payload encryption (must be URL-safe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_KEY=your-32-byte-aes-key-here

# ── Phase 4 — Database ───────────────────────────────────────────────────────
# SQLite (local, no setup required):
DATABASE_URL=sqlite:///./audit.db

# Supabase Postgres (production — replace with your project URL):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Phase 4 — Rate limiting ──────────────────────────────────────────────────
# Maximum requests per minute per registered agent
RATE_LIMIT_PER_MINUTE=60

# ── Phase 5 — Hub ────────────────────────────────────────────────────────────
HUB_PORT=8000
HUB_BASE_URL=http://localhost:8000

# ── Optional — LLM fraud explanation (Phase 3+) ──────────────────────────────
# Set to enable plain-English fraud explanations generated by Claude.
# Leave unset to use rule-based explanations (always available without this key).
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional — Supabase credentials (Phase 4+) ───────────────────────────────
# Required only if you switch DATABASE_URL to a Supabase connection string.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
