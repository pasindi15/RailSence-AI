# D — Maintenance & Asset Intelligence Agent
# Copy to .env and fill in real values. .env is gitignored.

# Data layer (shared Supabase project across all 4 agents)
DATABASE_URL=postgresql://...supabase.co/...
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pub/sub events (delay_alert consumed here, maintenance_alert published here)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# LLM
ANTHROPIC_API_KEY=

# Inter-agent auth (issued by the Hub / Security agent)
JWT_SECRET=
HUB_BASE_URL=http://localhost:8000
MAINTENANCE_AGENT_TOKEN=

# This service
MAINTENANCE_AGENT_PORT=8004
