# RailSense AI - Environment Configuration Example

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Connection String for SQLAlchemy (Supabase Database)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Service configuration
APP_HOST=0.0.0.0
APP_PORT=8003
AGENT_HUB_URL=http://localhost:8002
BOOKING_AGENT_URL=http://localhost:8003
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
LOG_LEVEL=info

# Per-Agent Rate Limiting (Communication Hub)
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_PER_MINUTE=30

# NIC Privacy Secret & Security Agent
NIC_HMAC_SECRET=your-nic-hmac-secret-key-here
SECURITY_AGENT_URL=http://localhost:8004

# SMTP Email Notification Configuration (Placeholders only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_USE_TLS=true

# Google Gemini LLM API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
