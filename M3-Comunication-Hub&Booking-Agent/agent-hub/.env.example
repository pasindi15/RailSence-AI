# ── Agent Hub environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
# All values here are non-secret development placeholders only.

# ── Service binding ───────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8002

# ── JWT Authentication (Phase 2) ──────────────────────────────────────────────
# In production, set JWT_SECRET_KEY via environment variable or secret manager.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# ── Downstream agent base URLs ────────────────────────────────────────────────
# Each value is read by registry.py and routing layer via os.getenv().
# Development defaults match these values; override in production.

# Passenger-facing conversational agent (another team member)
PASSENGER_AGENT_URL=http://localhost:8001

# Booking & Reservation Agent (Member C)
BOOKING_AGENT_URL=http://localhost:8003

# Security / authentication agent (another team member)
SECURITY_AGENT_URL=http://localhost:8004

# Train operations agent (another team member)
OPERATIONS_AGENT_URL=http://localhost:8005

# Maintenance agent (another team member)
MAINTENANCE_AGENT_URL=http://localhost:8006

# ── Database / Audit Persistence (Supabase PostgreSQL / SQLite) ────────────────
# Example for Supabase:
# DATABASE_URL=postgresql://postgres:your-supabase-password@db.abcdefghijklmnopqrst.supabase.co:5432/postgres
# Example for local development / testing:
DATABASE_URL=sqlite:///./railsense_hub_audit.db

# ── Logging ───────────────────────────────────────────────────────────────────
# Accepted values: debug | info | warning | error
LOG_LEVEL=info

