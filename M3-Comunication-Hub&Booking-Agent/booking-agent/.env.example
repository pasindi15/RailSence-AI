# ── Booking Agent environment variables ──────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# ── Service binding ───────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8003

# ── PostgreSQL connection string ──────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
# Example for local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/railsense

# ── Agent Hub base URL (Phase 2 callbacks) ────────────────────────────────────
AGENT_HUB_URL=http://localhost:8002

# ── Logging ───────────────────────────────────────────────────────────────────
# Accepted values: debug | info | warning | error
LOG_LEVEL=info
