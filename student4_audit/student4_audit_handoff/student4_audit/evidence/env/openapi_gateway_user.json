  "components": {
    "schemas": {
      "AdminNLPPreviewReq": {
        "properties": {
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Administrator rejection text to analyze"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "AdminNLPPreviewReq"
      },
      "AdminReviewActionInput": {
        "properties": {
          "decision": {
            "type": "string",
            "title": "Decision",
            "default": "APPROVE"
          },
          "admin_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Admin Reason"
          }
        },
        "type": "object",
        "title": "AdminReviewActionInput"
      },
      "ChatInput": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message",
            "description": "Passenger user message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Optional session tracking ID"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatInput"
      },
      "ConfirmBookingInput": {
        "properties": {
          "from_station": {
            "type": "string",
            "title": "From Station",
            "default": ""
          },
          "to_station": {
            "type": "string",
            "title": "To Station",
            "default": ""
          },
          "travel_date": {
            "type": "string",
            "title": "Travel Date",
            "default": ""
          },
          "train_id": {
            "type": "string",
            "title": "Train Id",
            "default": ""
          },
          "seat_class": {
            "type": "string",
            "title": "Seat Class",
            "default": ""
          },
          "passenger_count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Passenger Count",
            "default": 1
          },
          "passenger_email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
