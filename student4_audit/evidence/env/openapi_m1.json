      "get": {
        "summary": "Train Details",
        "operationId": "train_details_trains__train_id__details_get",
        "parameters": [
          {
            "name": "train_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Train Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
