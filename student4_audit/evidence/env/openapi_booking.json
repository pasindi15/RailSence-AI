          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "description": "Schema version",
            "default": "1.1"
          },
          "hop_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Hop Count",
            "description": "Monotonic hop counter",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "sender_agent",
          "receiver_agent",
          "intent",
          "payload",
          "auth_token",
          "timestamp"
        ],
        "title": "AgentMessage",
        "description": "Standard message envelope exchanged between agents via the Agent Hub.\n\nAttributes\n----------\nmessage_id:        Unique identifier for this message (e.g. \"MSG-2001\").\nsender_agent:      Logical name of the originating agent.\nreceiver_agent:    Logical name of the target agent.\nintent:            The action the receiver should perform.\npayload:           Arbitrary JSON-compatible dict carrying intent-specific data.\nauth_token:        Raw bearer token forwarded from the originating request.\ntimestamp:         ISO-8601 datetime (timezone-aware recommended) of when the\n                   message was created.\ncorrelation_id:    Unique ID spanning all related messages in a business workflow.\nparent_message_id: Direct causal predecessor message ID if applicable.\nschema_version:    Version identifier for the envelope schema.\nhop_count:         Monotonically incremented dispatch counter for loop prevention."
      },
