    "/internal/cancellations/{case_reference}/review": {
      "post": {
        "tags": [
          "cancellations"
        ],
        "summary": "Human-in-the-Loop Admin Review (Approve or Reject)",
        "description": "Execute human administrator review:\n- APPROVE: transitions Booking.status -> CANCELLED and CancellationRequest.status -> APPROVED\n- REJECT: keeps Booking.status as CONFIRMED and transitions CancellationRequest.status -> REJECTED",
        "operationId": "review_cancellation_endpoint_internal_cancellations__case_reference__review_post",
        "parameters": [
          {
            "name": "case_reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Reference"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminReviewInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Adjudication outcome",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
