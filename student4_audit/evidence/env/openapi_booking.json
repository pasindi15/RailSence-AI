  "components": {
    "schemas": {
      "AdminChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "description": "'user' or 'assistant'"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Message text"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "AdminChatMessage"
      },
      "AdminChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "description": "Natural language question from administrator"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Optional conversation tracking ID"
          },
          "history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/AdminChatMessage"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "History",
            "description": "Recent conversation turns for follow-up context"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AdminChatRequest"
      },
      "AdminChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "Grounded natural-language answer for the administrator"
          },
          "intent": {
            "type": "string",
            "title": "Intent",
            "description": "Classified intent"
          },
          "entities": {
            "additionalProperties": true,
            "type": "object",
            "title": "Entities",
            "description": "Extracted entities"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceEvidence"
            },
            "type": "array",
            "title": "Sources",
            "description": "Verified evidence sources"
          },
          "data_source": {
            "type": "string",
            "title": "Data Source",
            "description": "Database used for the live answer",
            "default": "m3_database"
          },
          "card": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CardPayload"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional structured presentation card"
          },
          "retrieved_records": {
            "type": "integer",
            "title": "Retrieved Records",
            "description": "Number of primary database records retrieved",
            "default": 0
          },
          "is_fallback": {
            "type": "boolean",
            "title": "Is Fallback",
            "description": "True if response generated via deterministic synthesizer",
            "default": false
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Conversation tracking ID"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "intent"
        ],
        "title": "AdminChatResponse"
      },
      "AdminNLPPreviewInput": {
        "properties": {
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Administrator's proposed rejection explanation"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "AdminNLPPreviewInput"
      },
      "AdminReviewInput": {
