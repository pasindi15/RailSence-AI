    "/internal/messages": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Receive a forwarded AgentMessage from the Hub (Phase 3: Booking dispatch)",
        "description": "Handle forwarded AgentMessage from the Central Communication Hub.\n\nSupported intents:\n- booking_request: validates payload using BookingRequest, calls BookingService,\n  and returns structured booking confirmation.\n- cancel_booking: returns not-implemented response (reserved for subsequent phases).",
        "operationId": "receive_internal_message_internal_messages_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentMessage"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Message processed and booking confirmation returned",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
