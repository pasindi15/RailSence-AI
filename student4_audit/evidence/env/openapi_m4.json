  "components": {
    "schemas": {
      "AssetHealthRequest": {
        "properties": {
          "asset_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Asset Id"
          },
          "asset_type": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Asset Type"
          },
          "days_since_service": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Days Since Service",
            "default": 0
          },
          "fault_count_30d": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Fault Count 30D",
            "default": 0
          },
          "sensors": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sensors"
          },
          "fault_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault Type",
            "default": "none"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "asset_type"
        ],
        "title": "AssetHealthRequest"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          },
          "asset_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Type",
            "default": ""
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "EngineerLoginRequest": {
        "properties": {
          "engineer_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Engineer Id"
          },
          "password": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "engineer_id",
          "password"
        ],
        "title": "EngineerLoginRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HubMessageRequest": {
        "properties": {
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "sender_agent": {
            "type": "string",
            "title": "Sender Agent"
          },
          "receiver_agent": {
            "type": "string",
            "title": "Receiver Agent",
            "default": "maintenance-agent"
          },
          "intent": {
            "type": "string",
            "title": "Intent"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "auth_token": {
            "type": "string",
            "title": "Auth Token",
            "default": ""
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "sender_agent",
          "intent"
        ],
        "title": "HubMessageRequest"
      },
      "MaintenanceReportRequest": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "asset_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Asset Id"
          },
          "asset_type": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Asset Type"
          },
          "station": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Station"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Text"
          },
          "technician_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Technician Id"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "asset_type",
          "station",
          "text"
        ],
        "title": "MaintenanceReportRequest"
      },
      "ResolveReportRequest": {
        "properties": {
          "action_taken": {
            "type": "string",
            "maxLength": 200,
            "title": "Action Taken",
            "default": ""
          },
          "health_after": {
            "type": "string",
            "pattern": "^(GREEN|AMBER|RED)$",
            "title": "Health After",
            "default": "GREEN"
          },
          "priority": {
            "type": "string",
            "pattern": "^(routine|urgent|critical)$",
            "title": "Priority",
            "default": "routine"
          },
          "notes": {
            "type": "string",
            "maxLength": 300,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "title": "ResolveReportRequest"
      },
      "TrainFlagRequest": {
        "properties": {
          "train_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Train Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          },
          "severity": {
            "type": "string",
            "pattern": "^(AMBER|RED)$",
            "title": "Severity",
            "default": "RED"
          },
          "flagged_by": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Flagged By"
          },
          "estimated_clear": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Clear"
          },
